@page "/"
@using JobHunter.Jobs
@using JobHunter.Llm
@using JobHunter.Llm.Exchange

<PageTitle>Inbox</PageTitle>

<div class="page-head">
    <h1>Inbox</h1>

    <div class="exchange-bar">
        <span class="awaiting"><b class="data">@awaitingScoreCount</b> waiting for a score</span>
        <BusyButton class="btn btn-sm btn-quiet" OnClick="ExportAsync" Disabled="@exchangeBusy"><i class="bi bi-box-arrow-up" aria-hidden="true"></i>Export</BusyButton>
        <BusyButton class="btn btn-sm btn-quiet" OnClick="ImportAsync" Disabled="@exchangeBusy"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>Import</BusyButton>
    </div>
</div>

@if (ExportHintVisible)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">@awaitingScoreCount job(s) passed the rules and carry no score, and the Score button needs a key.</p>
        <p class="mb-1">@ApiKeyDetector.MissingKeyMessage</p>
        <p class="mb-0">Once the score-jobs skill has written its file, Import brings the scores in.</p>
    </div>
}

@if (exportResult is not null)
{
    <p class="exchange-result">Exported @exportResult.JobsToScore job(s) to score and @exportResult.JobsToKit to kit into @exportResult.Folder.</p>
}

@if (importResult is not null)
{
    <p class="exchange-result">Imported @importResult.ScoresImported score(s) and @importResult.KitsImported kit(s).</p>

    @if (importResult.Rejections.Count > 0)
    {
        <ul class="rejections">
            @foreach (ExchangeLineRejection rejection in importResult.Rejections)
            {
                <li>@rejection.File line @rejection.LineNumber: @rejection.Reason</li>
            }
        </ul>
    }
}

<div class="filters">
    <label>
        Class
        <select class="form-select form-select-sm" @bind="filter.Class" @bind:after="() => GoToPageAsync(0)">
            <option value="">all</option>
            <option value="@JobClass.A">@JobClass.A</option>
            <option value="@JobClass.B">@JobClass.B</option>
        </select>
    </label>

    <label>
        Pay
        <select class="form-select form-select-sm" @bind="filter.Pay" @bind:after="() => GoToPageAsync(0)">
            <option value="@InboxPayFilter.Any">any</option>
            <option value="@InboxPayFilter.Stated">stated</option>
            <option value="@InboxPayFilter.NotStated">not stated</option>
        </select>
    </label>

    <label>
        Location
        <select class="form-select form-select-sm" @bind="filter.Place" @bind:after="() => GoToPageAsync(0)">
            <option value="@InboxPlaceFilter.Any">any</option>
            <option value="@InboxPlaceFilter.Remote">remote</option>
            <option value="@InboxPlaceFilter.OnsiteWithRelocation">onsite or hybrid, relocation offered</option>
            <option value="@InboxPlaceFilter.Rest">everything else</option>
        </select>
    </label>

    <FlagPicker @bind-Flags="filter.Flags" @bind-Flags:after="() => GoToPageAsync(0)" Settings="settings" />

    <label>
        Posted within (days)
        <input class="form-control form-control-sm" type="number" min="1" @bind="postedWithinDays" @bind:after="FilterByAgeAsync" placeholder="any" />
    </label>
</div>

@if (inboxPage is null)
{
    <p>Reading the inbox.</p>
}
else if (inboxPage.Rows.Count == 0)
{
    <p class="empty-inbox">@(filter.Class is null && filter.Flags.Count == 0 && filter.PostedSince is null && filter.Pay == InboxPayFilter.Any && filter.Place == InboxPlaceFilter.Any ?"No class A or B job is waiting for a decision." : "No class A or B job waiting for a decision matches the filters.")</p>
}
else
{
    @foreach (IGrouping<JobClass, InboxRow> group in ClassGroups)
    {
        <section class="class-group" @key="group.Key">
            <h2 class="group-head">Class @group.Key · @inboxPage.ClassCounts.GetValueOrDefault(group.Key)<span class="rule" aria-hidden="true"></span></h2>

            <div class="rows">
                @foreach (InboxRow row in group)
                {
                    <article class="inbox-row" @key="row.Id">
                        <div class="score">
                            <span class="total">@row.Total<small>/14</small></span>
                            <ScoreRibbon Points="row.Points" />
                        </div>

                        <div class="who">
                            <a class="title" href="/jobs/@row.Id">@row.Title</a><span class="company">@row.Company</span>
                            <div class="meta">
                                @if (row.CompMinPerYear is null && row.CompMaxPerYear is null)
                                {
                                    <span class="pay unknown">pay @JobDisplay.CompUnknown</span>
                                }
                                else
                                {
                                    <span class="pay">@JobDisplay.Comp(row.CompMinPerYear, row.CompMaxPerYear, settings.BaseCurrency)</span>
                                }
                                <span>@JobDisplay.Place(row.RemotePolicy, row.LocationText, row.CountryIso)</span>
                                <span>@row.LevelGuess</span>
                                <span>@JobDisplay.Age(row.PostedAt, row.FirstSeenAt)</span>
                                @foreach (JobFlag flag in JobDisplay.FlagsShownOnInbox(row.Flags, settings))
                                {
                                    <span class="chip @JobDisplay.FlagTone(flag, settings)" title="@JobDisplay.FlagMeaning(flag, settings)"><code>@JobDisplay.FlagCode(flag, settings)</code>@JobDisplay.FlagLabel(flag)</span>
                                }
                            </div>
                        </div>

                        <div class="actions">
                            <button class="btn btn-sm btn-quiet" @onclick="() => ToggleAsync(row.Id)">@(expandedRows.Contains(row.Id) ? "Hide" : "Why")</button>
                            <BusyButton class="btn btn-sm btn-primary" OnClick="() => PursueAsync(row.Id)" Disabled="@IsBusy">Save</BusyButton>
                            <BusyButton class="btn btn-sm btn-quiet btn-skip" OnClick="() => SkipAsync(row.Id)" Disabled="@IsBusy">Skip</BusyButton>
                        </div>

                        @if (expandedRows.Contains(row.Id))
                        {
                            <div class="why">
                                <span class="label">Reasoning</span>
                                <p class="reasoning">@row.Reasoning</p>
                                <pre class="description">@Description(row.Id)</pre>
                            </div>
                        }
                    </article>
                }
            </div>
        </section>
    }

    <ListPager PageIndex="filter.PageIndex" TotalCount="inboxPage.TotalCount" PageSize="Paging.PageSize" PageChanged="GoToPageAsync" />
}

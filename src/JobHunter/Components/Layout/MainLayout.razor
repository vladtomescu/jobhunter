@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject PageLoading Loading

<PageLoader />

<div class="app">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <div class="statusbar">
            <RefreshPanel />
        </div>

        <article class="content">
            <ErrorBoundary @ref="pageErrors">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="failure">
                    <div class="alert alert-danger" role="alert">
                        <p class="mb-1">This page stopped: @failure.Message</p>
                        <a href="@Navigation.Uri" @onclick="Reload" @onclick:preventDefault="true">Reload the page</a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? pageErrors;
    private IDisposable? navigationWatch;

    /// <summary>Clears the error of the previous page whenever the layout is handed a new one, so that a failure on one page does not follow the user around the app, and stops the loading bar a link started.</summary>
    protected override void OnParametersSet()
    {
        pageErrors?.Recover();
        Loading.EndNavigation();
    }

    /// <summary>Starts the loading bar whenever a link leads to another page; this runs only once the circuit is live, so the prerender registers nothing.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            navigationWatch = Navigation.RegisterLocationChangingHandler(_ => Loading.StartNavigationAsync());
        }
    }

    /// <summary>Removes the navigation handler when the circuit closes.</summary>
    public void Dispose()
    {
        navigationWatch?.Dispose();
    }

    /// <summary>Loads the current address again from the server, which builds the page from a clean state.</summary>
    private void Reload()
    {
        Navigation.Refresh(forceReload: true);
    }
}

@page "/jobs/add"

<PageTitle>Add job</PageTitle>

<h1>Add job</h1>

<p class="lead-in">Paste the link and the posting text; the next score run scores it like any other job.</p>

<EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="add-job">
    <DataAnnotationsValidator />

    @* The layout class sits on a div this page renders, since the form element comes from EditForm and never carries this page's CSS scope. *@
    <div class="add-job-form">
        <ValidationSummary />

        <label>
            Apply link
            <InputText class="form-control" @bind-Value="form.ApplyUrl" placeholder="https://" />
        </label>

        <label>
            Title
            <InputText class="form-control" @bind-Value="form.Title" />
        </label>

        <label>
            Company
            <InputText class="form-control" @bind-Value="form.Company" />
        </label>

        <label>
            Location
            <InputText class="form-control" @bind-Value="form.LocationText" placeholder="optional" />
        </label>

        <label>
            Compensation
            <InputText class="form-control" @bind-Value="form.CompText" placeholder="optional, for instance 90,000 - 120,000 EUR per year" />
        </label>

        <label class="description">
            Description
            <InputTextArea class="form-control" rows="14" @bind-Value="form.DescriptionText" />
        </label>

        <button class="btn btn-primary" type="submit" disabled="@busy">Add job</button>
    </div>
</EditForm>

@page "/jobs/{Id:guid}"
@using JobHunter.Jobs
@using JobHunter.Pipeline

<PageTitle>Job</PageTitle>

@if (view is null)
{
    <h1>Job</h1>
    <p class="not-found">No job is stored under that identifier.</p>
}
else
{
    <header class="job-head">
        <h1>@view.Job.Title</h1>
        <p class="company">@view.Job.Company</p>
        @if (view.Job.IsManual)
        {
            <a class="btn btn-sm btn-outline-secondary edit-job" href="/jobs/@view.Job.Id/edit"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
        }
    </header>

    <div class="job-grid">
        <div class="job-main">
            @if (view.Job.Score is ScoreCard verdict)
            {
                <section class="card verdict">
                    <h2>Why it scored @verdict.Total</h2>
                    <p class="reasoning">@verdict.Reasoning</p>

                    @{ string[] blockingUnknowns = [.. verdict.BlockingUnknowns.Where(unknown => Classifier.BlocksTheCandidate(unknown, settings))]; }
                    @if (blockingUnknowns.Length > 0)
                    {
                        <div class="chips">
                            <span class="chips-label">Blocking unknowns</span>
                            @foreach (string unknown in blockingUnknowns)
                            {
                                <span class="chip">@unknown</span>
                            }
                        </div>
                    }

                    @if (view.Job.Flags.Count > 0)
                    {
                        <div class="chips">
                            <span class="chips-label">Flags</span>
                            @foreach (JobFlag flag in view.Job.Flags)
                            {
                                <span class="chip @JobDisplay.FlagTone(flag, settings)" title="@JobDisplay.FlagMeaning(flag, settings)"><code>@JobDisplay.FlagCode(flag, settings, matchedStackKeyword)</code>@JobDisplay.FlagLabel(flag)</span>
                            }
                        </div>
                    }
                </section>
            }
            else if (view.Job.Flags.Count > 0)
            {
                <section class="card">
                    <h2>Flags</h2>
                    <div class="chips">
                        @foreach (JobFlag flag in view.Job.Flags)
                        {
                            <span class="chip @JobDisplay.FlagTone(flag, settings)" title="@JobDisplay.FlagMeaning(flag, settings)"><code>@JobDisplay.FlagCode(flag, settings, matchedStackKeyword)</code>@JobDisplay.FlagLabel(flag)</span>
                        }
                    </div>
                </section>
            }

            <section class="card">
                <h2>Facts</h2>
                <dl class="facts-grid">
                    <dt>Where</dt>
                    <dd>@JobDisplay.Place(view.Job.Score?.RemotePolicy, view.Job.LocationText, view.Job.CountryIso)</dd>

                    <dt>Pay</dt>
                    <dd class="@(view.Job.CompMinPerYear is null && view.Job.CompMaxPerYear is null ? "pay-unknown" : "data")">@JobDisplay.Comp(view.Job.CompMinPerYear, view.Job.CompMaxPerYear, settings.BaseCurrency)</dd>

                    <dt>Posted</dt>
                    <dd>@(view.Job.PostedAt is DateTimeOffset postedAt ? JobDisplay.LocalDate(postedAt) : "unknown") (first seen @JobDisplay.LocalDate(view.Job.FirstSeenAt))</dd>

                    <dt>State</dt>
                    <dd class="state">
                        @if (view.Job.Class is JobClass jobClass)
                        {
                            <span class="badge text-bg-primary">@jobClass</span>
                        }
                        <span>@view.Job.Prefilter</span>
                        <span class="text-muted">@JobDisplay.TriageLabel(view.Job.Triage)</span>
                        @if (!view.Job.IsActive)
                        {
                            <span class="badge text-bg-dark">inactive</span>
                        }
                        @if (view.Job.DropReason is string dropReason)
                        {
                            <span class="drop-reason">@dropReason</span>
                        }
                    </dd>

                    <dt>Sources</dt>
                    <dd class="job-sources">@SourceKinds(view.Job)</dd>

                    @if (view.Job.Score is ScoreCard facts)
                    {
                        <dt>Level</dt>
                        <dd>@facts.LevelGuess</dd>

                        <dt>Remote policy</dt>
                        <dd>@facts.RemotePolicy</dd>

                        <dt>Employment</dt>
                        <dd>@facts.EmploymentType</dd>

                        <dt>Timezone</dt>
                        <dd>@facts.TimezoneNote</dd>

                        <dt>United States authorization</dt>
                        <dd>@Tell(facts.RequiresUsAuthorization)</dd>

                        <dt>End client named</dt>
                        <dd>@Tell(facts.EndClientNamed)</dd>

                        <dt>What the intelligence work means</dt>
                        <dd>@facts.AiMeaning</dd>
                    }

                    <dt>Link</dt>
                    <dd>
                        <div class="apply-row">
                            <a href="@LinkUrl(view.Job)" target="_blank" rel="noreferrer">@LinkUrl(view.Job)</a>
                            <button class="btn btn-sm btn-outline-secondary" title="Copy link" aria-label="Copy link" @onclick="() => CopyAsync(LinkUrl(view.Job))"><i class="bi bi-clipboard" aria-hidden="true"></i></button>
                        </div>
                    </dd>

                    @if (PaywalledBoardSearch.IsPaywalledBoard(LinkUrl(view.Job)))
                    {
                        <dt>Find it</dt>
                        <dd class="find-it-row">
                            @foreach (BoardSearchLink searchLink in PaywalledBoardSearch.BuildSearchLinks(view.Job.Company, view.Job.Title))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@searchLink.Url" target="_blank" rel="noopener"><i class="bi bi-search" aria-hidden="true"></i><span>@searchLink.Label</span></a>
                            }
                        </dd>
                    }
                </dl>
            </section>

            @if (view.Application is Application application)
            {
                <section class="card kit">
                    <h2>Application kit</h2>
                    <p class="kit-state">Status @application.Status, kit @application.KitState.</p>

                    @if (application.KitState is KitState.Failed or KitState.None)
                    {
                        <button class="btn btn-outline-secondary rewrite-kit" @onclick="WriteKitAsync" disabled="@busy"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>@(application.KitState == KitState.None ? "Write the kit" : "Write the kit again")</button>
                    }

                    @if (application.KitState == KitState.Generating)
                    {
                        <p class="generating"><span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Writing the kit.</p>
                    }

                    @if (application.KitError is string kitError)
                    {
                        <p class="kit-error">@kitError</p>
                    }

                    @if (application.Kit is ApplicationKit kit)
                    {
                        @if (kit.LintIssues.Count > 0)
                        {
                            <ul class="lint-issues">
                                @foreach (string issue in kit.LintIssues)
                                {
                                    <li>@issue</li>
                                }
                            </ul>
                        }

                        <article class="kit-section">
                            <h3>Fit summary <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyAsync(FitSummaryText(kit))">Copy</button></h3>
                            <ul>
                                @foreach (string line in kit.FitSummary)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </article>

                        <article class="kit-section">
                            <h3>Cover note <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyAsync(kit.CoverNote)">Copy</button></h3>
                            <pre>@kit.CoverNote</pre>
                        </article>

                        <article class="kit-section">
                            <h3>Standard answers <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyAsync(AtsAnswersText(kit))">Copy</button></h3>
                            <dl>
                                @foreach (AtsAnswer answer in kit.AtsAnswers)
                                {
                                    <dt>@answer.Question</dt>
                                    <dd>@answer.Answer</dd>
                                }
                            </dl>
                        </article>

                        <article class="kit-section">
                            <h3>Questions for the first call <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyAsync(CallQuestionsText(kit))">Copy</button></h3>
                            <ul>
                                @foreach (string question in kit.CallQuestions)
                                {
                                    <li>@question</li>
                                }
                            </ul>
                        </article>

                        <p class="kit-provenance">Resume @kit.ResumePath, @kit.Model, written @JobDisplay.LocalTime(kit.GeneratedAt)</p>
                    }
                </section>
            }

            <section class="card description">
                <h2>Posting</h2>
                <pre>@view.Job.DescriptionText</pre>
            </section>
        </div>

        <aside class="rail">
            <section class="card">
                @if (view.Job.Score is ScoreCard score)
                {
                    <div class="rail-score">
                        <span class="total">@score.Total</span><span class="of">of 14</span>
                        @if (view.Job.Class is JobClass scoredClass)
                        {
                            <span class="class-chip">Class @scoredClass</span>
                        }
                    </div>
                    <ScoreRibbon Points="ScorePoints.From(score)" Labelled="true" />
                }
                else if (view.Job.Scoring == ScoringState.Failed)
                {
                    <p class="scoring-state scoring-failed">Scoring failed: @(view.Job.ScoreError ?? "no reason recorded"). The next score run tries again.</p>
                }
                else
                {
                    <p class="scoring-state">Unscored: this job has no score yet. The next score run scores it.</p>
                }

                <button class="btn btn-outline-secondary score-again" @onclick="ScoreAgainAsync" disabled="@busy"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Score again</button>

                <div class="decide">
                    @if (message is string note)
                    {
                        <p class="action-message" role="status">@note</p>
                    }

                    @if (view.Application is Application tracked)
                    {
                        <div class="triage-status pursued">
                            <span class="triage-label">@StatusLabel(tracked.Status) @JobDisplay.LocalDate(tracked.StatusChangedAt)</span>
                            <a href="/pipeline">Open the pipeline</a>
                        </div>
                        @if (tracked.Status == ApplicationStatus.Saved)
                        {
                            @if (isConfirmingUnpursue)
                            {
                                <div class="unpursue-confirm">
                                    <span>Unsave? This deletes @UnpursueLosses(tracked), and the job goes back to the inbox.</span>
                                    <div class="pair">
                                        <button class="btn btn-outline-danger" @onclick="UnpursueAsync" disabled="@busy">Confirm unsave</button>
                                        <button class="btn btn-outline-secondary" @onclick="CancelUnpursue" disabled="@busy">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary" @onclick="AskToConfirmUnpursue" disabled="@busy"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Unsave</button>
                            }
                        }
                    }
                    else if (view.Job.Triage == TriageState.Skipped)
                    {
                        <div class="triage-status skipped">
                            <span class="triage-label">Skipped@(view.Job.TriagedAt is DateTimeOffset skippedAt ? $" {JobDisplay.LocalDate(skippedAt)}" : null)</span>
                        </div>
                        <button class="btn btn-outline-primary" @onclick="PursueAsync" disabled="@busy"><i class="bi bi-check2" aria-hidden="true"></i>Save after all</button>
                    }
                    else
                    {
                        <div class="pair">
                            <button class="btn btn-primary" @onclick="PursueAsync" disabled="@busy"><i class="bi bi-check2" aria-hidden="true"></i>Save</button>
                            <button class="btn btn-outline-secondary btn-skip" @onclick="SkipAsync" disabled="@busy"><i class="bi bi-x-lg" aria-hidden="true"></i>Skip</button>
                        </div>
                    }
                    <button class="btn btn-outline-secondary" @onclick="PrefillAsync" disabled="@busy"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>Open and prefill</button>
                </div>

                @if (view.Job.Score is ScoreCard scored)
                {
                    <p class="provenance">@scored.Model, scored @JobDisplay.LocalTime(scored.ScoredAt)</p>
                }
            </section>

            <section class="card mark-applied">
                <h2>Mark applied</h2>
                <label>
                    Channel
                    <select class="form-select form-select-sm" @bind="channel">
                        @foreach (ApplicationChannel value in Enum.GetValues<ApplicationChannel>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                </label>
                <label>
                    Note
                    <input class="form-control form-control-sm" @bind="appliedNote" placeholder="optional" />
                </label>
                <button class="btn btn-outline-secondary" @onclick="MarkAppliedAsync" disabled="@busy"><i class="bi bi-send-check" aria-hidden="true"></i>Mark applied</button>
            </section>
        </aside>
    </div>
}

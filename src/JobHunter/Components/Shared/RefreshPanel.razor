@using JobHunter.Refresh

<div class="refresh-panel">
    <div class="refresh-bar">
        <button type="button" class="btn btn-primary btn-sm" disabled="@State.IsRunning" @onclick="RefreshAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Refresh</button>
        <button type="button" class="btn btn-primary btn-sm" disabled="@ScoreDisabled" title="@ScoreTitle" @onclick="ScoreAsync"><i class="bi bi-play-fill" aria-hidden="true"></i>Score @AwaitingText</button>

        @if (State.IsRunning)
        {
            <span class="refresh-activity">@RunningText</span>
        }
        else if (LastRun is RefreshRunSummary finished)
        {
            <div class="refresh-facts">
                @if (finished.Trigger == FetchTrigger.Score)
                {
                    <span>Last score run @finished.Outcome.ToString().ToLowerInvariant()@FinishedAtText(finished)</span>
                    <span><b>@finished.Scored</b> scored</span>
                    @if (finished.ScoreFailures > 0)
                    {
                        <a class="refresh-warn" href="runs"><b>@finished.ScoreFailures</b> scoring failures</a>
                    }
                    else
                    {
                        <span><b>@finished.ScoreFailures</b> scoring failures</span>
                    }
                }
                else
                {
                    <span>Last refresh @finished.Trigger.ToString().ToLowerInvariant(), @finished.Outcome.ToString().ToLowerInvariant()@FinishedAtText(finished)</span>
                    <span><b>@finished.NewJobs</b> new</span>
                    <span><b>@finished.UpdatedJobs</b> updated</span>
                    <span><b>@finished.MarkedInactive</b> inactive</span>
                    <span><b>@finished.MarkedStale</b> stale</span>
                }
            </div>
        }
        else
        {
            <span class="refresh-activity">Nothing has run yet.</span>
        }

        @if (Message is string message)
        {
            <span class="refresh-message">@message</span>
        }
    </div>

    @if (SourceLines.Count > 0)
    {
        <ul class="refresh-sources">
            @foreach (SourceRunResult line in SourceLines)
            {
                <li>
                    <span class="refresh-source">@line.Kind</span>
                    <span>fetched <b>@line.Fetched</b></span>
                    <span>new <b>@line.New</b></span>
                    <span>updated <b>@line.Updated</b></span>
                    <span>dropped <b>@line.Dropped</b></span>
                    @if (line.Error is string error)
                    {
                        <span class="refresh-error">@error</span>
                    }
                </li>
            }
        </ul>
    }

    @if (ScoringHaltReason is string haltReason)
    {
        <p class="refresh-halt">Scoring stopped early: @haltReason. The jobs not sent stay unscored for the next score run (<a href="runs">run details</a>).</p>
    }

    @if (RunError is string runError)
    {
        <p class="refresh-error">@runError</p>
    }
</div>

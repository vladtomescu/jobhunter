@page "/settings"
@using JobHunter.Jobs

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<div id="settings-page">

    <section class="settings-section">
        <h2>API key</h2>
        @if (ApiKeyDetector.IsPresent)
        {
            <p class="text-success">API key detected: Yes</p>
        }
        else
        {
            <p class="text-danger">API key detected: No</p>
        }
        <p class="text-muted">
            Checked first in <code>@JobHunter.Llm.ApiKeyDetector.LocalSettingsFile</code>, then the <code>@JobHunter.Llm.ApiKeyDetector.VariableName</code> environment variable. The value itself is never shown here.
        </p>
    </section>

    <EditForm Model="Model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <section class="settings-section">
            <h2>Contact</h2>
            <div class="mb-2">
                <label class="form-label" for="first-name">First name</label>
                <InputText id="first-name" class="form-control" @bind-Value="Model.FirstName" />
                <div class="form-text">Typed into the first-name field when Prefill opens an application form.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="last-name">Last name</label>
                <InputText id="last-name" class="form-control" @bind-Value="Model.LastName" />
                <div class="form-text">Typed into the last-name field when Prefill opens an application form.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="email">Email</label>
                <InputText id="email" class="form-control" @bind-Value="Model.Email" />
                <div class="form-text">Typed into the email field when Prefill opens an application form.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="phone">Phone</label>
                <InputText id="phone" class="form-control" @bind-Value="Model.Phone" />
                <div class="form-text">Typed into the phone field when Prefill opens an application form.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="location">Location</label>
                <InputText id="location" class="form-control" @bind-Value="Model.Location" />
                <div class="form-text">Typed into the location field when Prefill opens an application form, on the ATS boards that have one.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="linkedin">LinkedIn URL</label>
                <InputText id="linkedin" class="form-control" @bind-Value="Model.LinkedInUrl" />
                <div class="form-text">Typed into the LinkedIn field when Prefill opens an application form; the generated kit text keeps a placeholder here instead.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Resume</h2>
            <div class="mb-2">
                <label class="form-label" for="resume-pdf">Resume PDF path</label>
                <div class="d-flex align-items-center gap-2">
                    <InputText id="resume-pdf" class="form-control" @bind-Value="Model.ResumePdfPath" />
                    @if (ResumePdfExists)
                    {
                        <span class="badge bg-success">Found</span>
                        <a href="/settings/resume/pdf" target="_blank" rel="noopener" title="Opens the PDF at the currently saved path, not any unsaved edit above. Save first if you just changed it.">View</a>
                    }
                    else
                    {
                        <span class="badge bg-danger">Missing</span>
                    }
                </div>
                <div class="form-text">Uploaded as the resume file when Prefill opens an application form, and recorded as the CV version when you mark an application applied. Takes effect on save; already-open forms are unaffected.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="resume-md">Resume markdown path</label>
                <div class="d-flex align-items-center gap-2">
                    <InputText id="resume-md" class="form-control" @bind-Value="Model.ResumeMarkdownPath" />
                    @if (ResumeMarkdownExists)
                    {
                        <span class="badge bg-success">Found</span>
                        <a href="/settings/resume/markdown" target="_blank" rel="noopener" title="Opens the markdown at the currently saved path, not any unsaved edit above. Save first if you just changed it.">View</a>
                    }
                    else
                    {
                        <span class="badge bg-danger">Missing</span>
                    }
                </div>
                <div class="form-text">Read into the prompt that writes the kit's cover note, fit summary and answers on the next Pursue, and copied into the no-key export folder.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Candidate</h2>
            <div class="mb-2">
                <label class="form-label" for="home-country">Home country (ISO code)</label>
                <InputText id="home-country" class="form-control" @bind-Value="Model.HomeCountryIso" />
                <div class="form-text">The two-letter code of the country you live in, for example DE; it decides which region's roles and working hours count as yours. Leave blank for none.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="home-city">Home city</label>
                <InputText id="home-city" class="form-control" @bind-Value="Model.HomeCity" />
                <div class="form-text">The city you live in, for example Utrecht; an onsite or hybrid role whose location names it is flagged as in your home city, with or without diacritics. Leave blank for none.</div>
            </div>
            <div class="form-check">
                <InputCheckbox id="accept-europe-remote" class="form-check-input" @bind-Value="Model.AcceptEuropeRemote" />
                <label class="form-check-label" for="accept-europe-remote">Accept Europe remote</label>
            </div>
            <div class="form-text">Remote roles restricted to Europe or its working hours count as within your accepted regions.</div>
            <div class="form-check">
                <InputCheckbox id="accept-us-remote" class="form-check-input" @bind-Value="Model.AcceptUnitedStatesRemote" />
                <label class="form-check-label" for="accept-us-remote">Accept US remote</label>
            </div>
            <div class="form-text">When on, a remote role restricted to United States hours or residency passes the prefilter (flagged H3) instead of being dropped. Applied to new or re-prefiltered postings on the next Refresh.</div>
            <div class="mb-2 mt-2">
                <label class="form-label" for="accepted-languages">Posting languages (comma-separated ISO codes)</label>
                <InputText id="accepted-languages" class="form-control" @bind-Value="Model.AcceptedLanguages" />
                <div class="form-text">The languages a posting may be written in, for example en, de; postings in any other language are dropped.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="base-currency">Base currency (ISO code)</label>
                <InputText id="base-currency" class="form-control" @bind-Value="Model.BaseCurrency" />
                <div class="form-text">The currency pay is counted in: the compensation minimums and target below, the high-pay threshold, and every job's pay per year.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="stack-keywords">Stack keywords (comma-separated)</label>
                <InputText id="stack-keywords" class="form-control" @bind-Value="Model.StackKeywords" />
                <div class="form-text">The technologies you work in, for example Java, Kotlin; a job whose title, tags or description names one is flagged as a stack match.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="contract-preference">Contract preference</label>
                <InputSelect id="contract-preference" class="form-select" @bind-Value="Model.ContractPreference">
                    @foreach (ContractPreference preference in Enum.GetValues<ContractPreference>())
                    {
                        <option value="@preference">@ContractPreferenceLabel(preference)</option>
                    }
                </InputSelect>
                <div class="form-text">Which contract form you take; it decides which compensation minimum applies when a posting does not say, and whether an employment-only role counts against a job.</div>
            </div>
            <div class="form-check">
                <InputCheckbox id="us-work-authorization" class="form-check-input" @bind-Value="Model.HasUnitedStatesWorkAuthorization" />
                <label class="form-check-label" for="us-work-authorization">Authorized to work in the United States</label>
            </div>
            <div class="form-text">When on, a posting that requires United States work authorization is not held back for it.</div>
            <div class="mb-2 mt-2">
                <label class="form-label" for="high-pay-threshold">High-pay threshold (@SavedBaseCurrency/year)</label>
                <InputNumber id="high-pay-threshold" class="form-control" @bind-Value="Model.HighPayThresholdPerYear" />
                <div class="form-text">Pay per year at or above which a job is flagged as high pay. Leave blank for none.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="title-include">Title include terms (one per line)</label>
                <InputTextArea id="title-include" class="form-control" rows="6" @bind-Value="Model.TitleIncludeTerms" />
                <div class="form-text">A job title has to contain one of these terms to be taken in.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="title-exclude">Title exclude terms (one per line)</label>
                <InputTextArea id="title-exclude" class="form-control" rows="6" @bind-Value="Model.TitleExcludeTerms" />
                <div class="form-text">A job title that contains any of these terms is dropped, whatever else it contains.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Compensation</h2>
            <div class="mb-2">
                <label class="form-label" for="min-b2b">Minimum B2B @SavedBaseCurrency/hour</label>
                <InputNumber id="min-b2b" class="form-control" @bind-Value="Model.MinContractorHourly" @oninput="OnB2bHourlyRateInput" />
                <div class="form-text">The floor for a B2B/contract role's hourly rate, annualized at @HoursPerYearText hours/year (@DaysPerYearText working days &times; 8h, about @HoursPerMonthText hours/month). Below it, scoring caps the job at class C. Takes effect on the next score run or Score again, not retroactively.</div>
                @if (liveContractorHourly is decimal contractorHourly)
                {
                    <div class="form-text text-info">@FormatB2bEquivalent(contractorHourly, SavedBaseCurrency)</div>
                }
            </div>
            <div class="mb-2">
                <label class="form-label" for="min-employment">Minimum employment @SavedBaseCurrency/year</label>
                <InputNumber id="min-employment" class="form-control" @bind-Value="Model.MinEmploymentAnnual" />
                <div class="form-text">The floor for an employment (not B2B) role's annual pay. Below it, scoring caps the job at class C. Takes effect on the next score run or Score again, not retroactively.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="target">Target @SavedBaseCurrency/year</label>
                <InputNumber id="target" class="form-control" @bind-Value="Model.TargetAnnual" />
                <div class="form-text">The stated pay a posting has to reach for the full comp score; below target but at or above the minimum still scores partial credit. Takes effect on the next score run or Score again, not retroactively.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Models</h2>
            <div class="mb-2">
                <label class="form-label" for="score-model">Score model</label>
                <InputText id="score-model" class="form-control" @bind-Value="Model.ScoreModel" />
                <div class="form-text">The Anthropic model the Score button and Score again send each job to for scoring. Takes effect on the next score.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="kit-model">Kit model</label>
                <InputText id="kit-model" class="form-control" @bind-Value="Model.KitModel" />
                <div class="form-text">The Anthropic model Pursue sends the job to for writing the kit. Takes effect on the next Pursue.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Sources</h2>
            <div class="form-check">
                <InputCheckbox id="remoteok" class="form-check-input" @bind-Value="Model.RemoteOkEnabled" />
                <label class="form-check-label" for="remoteok">RemoteOK</label>
            </div>
            <div class="form-text">Fetches RemoteOK's job feed on the next Refresh.</div>
            <div class="form-check">
                <InputCheckbox id="wwr" class="form-check-input" @bind-Value="Model.WwrEnabled" />
                <label class="form-check-label" for="wwr">WeWorkRemotely</label>
            </div>
            <div class="form-text">Fetches the WeWorkRemotely RSS feeds on the next Refresh.</div>
            <div class="form-check">
                <InputCheckbox id="dataset" class="form-check-input" @bind-Value="Model.DatasetEnabled" />
                <label class="form-check-label" for="dataset">Dataset</label>
            </div>
            <div class="form-text">Downloads and reads the daily ATS dataset slices on the next Refresh.</div>
            <div class="mb-2 mt-2">
                <label class="form-label" for="dataset-ats">Dataset ATS list (comma-separated)</label>
                <InputText id="dataset-ats" class="form-control" @bind-Value="Model.DatasetAtsList" />
                <div class="form-text">Which ATS dataset slices (for example greenhouse, lever, ashby, workable) are downloaded when Dataset is on. Read on the next Refresh.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Windows and guards</h2>
            <div class="mb-2">
                <label class="form-label" for="first-run-window">First-run window (days)</label>
                <InputNumber id="first-run-window" class="form-control" @bind-Value="Model.FirstRunWindowDays" />
                <div class="form-text">How many days back a Refresh takes postings in by their posted date; older postings are never taken in, and only postings inside this window count toward marking a job inactive. Applied on the next Refresh.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="ghost-threshold">Ghost threshold (days)</label>
                <InputNumber id="ghost-threshold" class="form-control" @bind-Value="Model.GhostThresholdDays" />
                <div class="form-text">An application with no status change for this many days is listed on Pipeline as a Ghosted candidate for you to confirm. Applied the next time you open Pipeline.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="auto-refresh">Auto-refresh after (hours)</label>
                <InputNumber id="auto-refresh" class="form-control" @bind-Value="Model.AutoRefreshAfterHours" />
                <div class="form-text">How stale the last completed Refresh must be before the app runs one automatically on startup; 0 turns the startup refresh off, and the Refresh button still runs one on demand. Checked the next time the app starts.</div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="max-scores">Max scores per run</label>
                <InputNumber id="max-scores" class="form-control" @bind-Value="Model.MaxScoresPerRun" />
                <div class="form-text">The most jobs one press of Score sends to the score model; a cost guard. Everything above it waits for the next press. Applied on the next score run.</div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Geography</h2>
            <div class="form-check">
                <InputCheckbox id="keep-onsite" class="form-check-input" @bind-Value="Model.KeepOnsiteWithCompOrRelocation" />
                <label class="form-check-label" for="keep-onsite">Keep onsite with comp or relocation</label>
            </div>
            <div class="form-text">When on, an onsite or hybrid role outside Europe passes the prefilter if it states pay or mentions relocation support; otherwise it is dropped. Applied to new or re-prefiltered postings on the next Refresh.</div>
        </section>

        <section class="settings-section">
            <h2>FX overrides</h2>
            <p class="text-muted">
                Units of currency per one unit of the base currency (@SavedBaseCurrency): for example <code>{"USD": 1.08}</code> means 1 @SavedBaseCurrency = 1.08 USD. A currency without an override takes the European Central Bank's daily rate, crossed through the euro. After a change of base currency, restate the overrides against the new one.
            </p>
            <div class="mb-2">
                <label class="form-label" for="fx-overrides">FX overrides JSON</label>
                <InputTextArea id="fx-overrides" class="form-control" rows="3" @bind-Value="Model.FxOverridesJson" />
                <div class="form-text">Overrides the ECB daily rate for the listed currency codes when a job's stated pay is converted to @SavedBaseCurrency. Takes effect the next time a rate is looked up: the next Refresh, the next Pursue, or the Fetch button below once saved.</div>
                @if (fxOverridesError is not null)
                {
                    <p class="text-danger">@fxOverridesError</p>
                }
            </div>
            <div class="mb-2">
                <button type="button" class="btn btn-secondary" disabled="@isFetchingFxRate" @onclick="FetchFxRateNowAsync">Fetch now with the saved settings</button>
                @if (fxFetchResult is not null)
                {
                    <span class="@(fxFetchFailed ? "text-danger" : "text-success") ms-2">@fxFetchResult</span>
                }
                <p class="text-muted mb-0">The fetch reads the saved overrides, so save an edited override before fetching with it.</p>
            </div>
            <p class="text-muted">
                @if (FxCacheLastWrittenAtLocal is { } cachedAt)
                {
                    @($"Cache last written: {JobDisplay.LocalTime(cachedAt)}")
                }
                else
                {
                    @:No cached rates on disk yet.
                }
            </p>
        </section>

        <div class="settings-section">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">Save</button>
            @if (savedConfirmationVisible && currentSettings is not null)
            {
                <span class="text-success ms-2">Saved at @JobDisplay.LocalTime(currentSettings.UpdatedAt).</span>
            }
            else if (currentSettings is not null)
            {
                <span class="text-muted ms-2">Last saved: @JobDisplay.LocalTime(currentSettings.UpdatedAt)</span>
            }
        </div>

    </EditForm>

    @if (currentSettings is not null)
    {
        <section class="settings-section" id="comp-recompute">
            <h2>Pay and classes</h2>
            @if (CompNeedsRecompute)
            {
                <p>
                    The base currency is now @currentSettings.BaseCurrency, but job pay, the compensation minimums, the target and the high-pay threshold are still counted in @currentSettings.CompComputedInCurrency.
                    Recompute converts them all at the current rate and reclassifies every scored job from its stored score, without calling the model. The reclassification applies the current minimums to every scored job, including jobs scored before a minimum was set. Unsaved edits on this page are discarded.
                </p>
                <button type="button" class="btn btn-warning" disabled="@isRecomputingComp" @onclick="RecomputeCompAsync">Recompute pay and classes</button>
            }
            else
            {
                <p>
                    Recompute reclassifies every scored job from its stored score with the current rules and minimums, and converts job pay at the current rate, without calling the model.
                    Use it after an update changes the class rules or after you change a minimum or the target. Unsaved edits on this page are discarded.
                </p>
                <button type="button" class="btn btn-outline-secondary" disabled="@isRecomputingComp" @onclick="RecomputeCompAsync">Recompute pay and classes</button>
            }
            @if (compRecomputeMessage is not null)
            {
                <p class="@(compRecomputeFailed ? "text-danger" : "text-success") mt-2 mb-0">@compRecomputeMessage</p>
            }
        </section>
    }

    <section class="settings-section" id="delete-old-jobs">
        <h2>Delete old jobs</h2>
        <div class="mb-2">
            <label class="form-label" for="retention-days">Older than (days)</label>
            <input id="retention-days" type="number" min="@RetentionMinimumDays" class="form-control" @bind="retentionDays" @bind:event="oninput" @bind:after="PreviewOldJobsAsync" disabled="@isDeletingOldJobs" />
            <div class="form-text">A job's age counts from its posting date, or from the day it was first seen when the posting has no date, the same age the job lists show. Jobs with an application and jobs added by hand are always kept. The minimum is the first-run window (@RetentionMinimumDays days), because a younger job would come back from the boards on the next Refresh. A delete cannot be undone.</div>
        </div>
        @if (retentionRefusal is not null)
        {
            <p class="text-danger">@retentionRefusal</p>
        }
        else if (isConfirmingDelete)
        {
            <div class="retention-confirm">
                <span>Delete @JobCountText(oldJobCount) older than @retentionDays days? This cannot be undone.</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger" disabled="@isDeletingOldJobs" @onclick="DeleteOldJobsAsync">Confirm delete</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@isDeletingOldJobs" @onclick="CancelDelete">Cancel</button>
                </div>
            </div>
        }
        else if (retentionDays is int previewedDays)
        {
            <button type="button" class="btn btn-outline-danger" disabled="@(oldJobCount == 0)" @onclick="AskToConfirmDelete">
                @(oldJobCount == 0 ? $"No jobs older than {previewedDays} days" : $"Delete {JobCountText(oldJobCount)} older than {previewedDays} days")
            </button>
        }
        @if (retentionResult is not null)
        {
            <p class="text-success mt-2 mb-0">@retentionResult</p>
        }
    </section>

</div>
